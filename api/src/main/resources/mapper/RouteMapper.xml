<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sele906.chaekeodi.route.mapper.RouteMapper">

    <select id="searchLibraries" resultType="CandidateLibrary">
        SELECT
        lib_code,
        name,
        address,
        latitude,
        longitude,
        region_code,
        dtl_region_code,

        <choose>
            <when test="latitude != null and longitude != null">
                ST_Distance(
                location,
                ST_SetSRID(
                ST_MakePoint(#{longitude}, #{latitude}),
                4326
                )::geography
                ) AS distance
            </when>
            <otherwise>
                NULL AS distance
            </otherwise>
        </choose>

        FROM library

        <!-- 사용자와 #{radius} 이내 도서관 출력 -->
        <if test="latitude != null and longitude != null">
            WHERE ST_DWithin(
            location,
            ST_SetSRID(ST_MakePoint(#{longitude}, #{latitude}), 4326)::geography,
            #{radius}
            )
        </if>

        ORDER BY
        distance,
        name

    </select>

    <select id="getBooksByIsbns" resultType="map">
        SELECT isbn13, title, authors, publisher, publication_year
        FROM book
        WHERE isbn13 IN
        <foreach collection="isbns"
                 item="isbn"
                 open="("
                 separator=","
                 close=")">
            #{isbn}
        </foreach>
    </select>

</mapper>